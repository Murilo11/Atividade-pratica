<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    tools:context=".HomeActivity">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="180dp"
        android:layout_height="140dp"
        android:layout_marginBottom="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/Codecamp" />

    <TextView
        android:id="@+id/tvNomeInstituicao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CodeCamp"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A" />

    <TextView
        android:id="@+id/tvCursos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Curso de T.I"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDescricao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:text="Portal para acesso das Disciplinas de T.I"
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center" />

    <Button
        android:id="@+id/ButtonCursos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/logo_blue"
        android:text="Conheça o curso" />

    <Button
        android:id="@+id/ButtonDisciplinas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/logo_blue"
        android:text="Disciplinas" />

</LinearLayout>